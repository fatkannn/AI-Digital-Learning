+    resources: [
+      { title: "Guidance for generative AI in education and research", source: "UNESCO", topic: "AI + E-learning", difficulty: "Beginner–Intermediate", minutes: 40, url: "https://www.unesco.org/en/articles/guidance-generative-ai-education-and-research", verified: true,
+        id: { apa: "Panduan global pertama UNESCO tentang AI generatif di pendidikan: apa yang perlu diatur, bagaimana memvalidasi alat sebelum dipakai, dan bagaimana merancang pemanfaatannya secara pedagogis.",
+          inti: ["Pendekatan berpusat pada manusia: AI menopang kemampuan pengajar dan pembelajar, bukan menggantikannya.", "Perlindungan data pribadi dan batas usia dinyatakan sebagai syarat, bukan saran.", "Alat perlu divalidasi secara etis dan pedagogis sebelum diadopsi institusi.", "Ada pembahasan implikasi jangka panjang terhadap penilaian dan cara mengajar.", "Dokumen kebijakan, bukan panduan teknis — kekuatannya sebagai rujukan resmi."],
