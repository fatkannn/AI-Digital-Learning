      { t: "tf", c: "Client vs server", q: "The frontend needs to know the database schema to display data.", a: false, e: "It only needs the API contract. That indirection is what lets the backend change its storage without breaking clients." },
      { t: "mc", c: "Where logic belongs", q: "In a graded course, where should the pass/fail decision be computed?", opts: ["In the browser, for speed", "On the server, because the client cannot be trusted", "In the database only", "Either is equally safe"], a: 1, e: "Client-side results can be tampered with. Any decision with consequences is computed server-side." },
      { t: "sc", c: "Where logic belongs", q: "You want an LMS page to show an AI summary. Which flow is sound?", opts: ["Browser calls the model provider directly with the key", "Browser calls your backend, which calls the model provider with a server-side key", "Database calls the model provider", "The model provider calls the browser"], a: 1, e: "The backend acts as a controlled gateway: it holds the secret, enforces limits and can log usage." },
