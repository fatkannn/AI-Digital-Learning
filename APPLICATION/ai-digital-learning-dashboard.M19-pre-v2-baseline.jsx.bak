    resources: [
      { title: "JSON — Working with structured data", source: "MDN Web Docs", topic: "Data formats", difficulty: "Beginner", minutes: 30, url: "https://developer.mozilla.org/en-US/docs/Learn", verified: true,
        id: { apa: "Dokumentasi belajar resmi MDN; bagian JSON menjelaskan struktur data yang paling sering dipakai untuk pertukaran data antar sistem.",
          inti: ["JSON terdiri dari objek, array, string, angka, boolean, null.", "Struktur bisa bersarang (nested).", "JSON dipakai hampir semua API modern.", "Parsing JSON mengubah teks menjadi struktur data di program.", "Format teks berarti bisa dibaca manusia dan mesin."],
          kenapa: "JSON adalah bahasa umum API, LLM structured output, dan hampir semua integrasi otomatisasi.",
