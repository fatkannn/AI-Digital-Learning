      { t: "sa", c: "AI limitations", q: "Give one reason an AI output should not be treated as truth by default.", a: { groups: [["hallucinat", "halusinas"], ["pattern", "pola"], ["probab", "peluang", "kemungkinan", "mungkin"], ["wrong", "salah", "keliru", "belum tentu benar"], ["confident", "meyakinkan", "yakin", "percaya diri"], ["verify", "periksa", "diperiksa", "verifikasi", "cek"]], need: 2, model: "Models generate plausible patterns rather than verified facts, and can be confidently wrong without signalling it." }, e: "Fluency is not accuracy." },
