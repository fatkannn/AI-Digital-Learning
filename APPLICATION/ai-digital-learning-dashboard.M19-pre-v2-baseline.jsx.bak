      { t: "mc", c: "Formats vs extensions", q: "What does a file extension actually guarantee?", opts: ["The internal structure of the file", "Nothing by itself — it is a naming hint about the intended format", "That the file is not corrupted", "The encoding used"], a: 1, e: "Renaming a file does not change its bytes. The format is determined by the content, not the name." },
      { t: "tf", c: "Encoding", q: "Text showing as garbled characters is usually a font problem.", a: false, e: "It is almost always an encoding mismatch: the bytes were written with one character encoding and read with another." },
      { t: "mc", c: "Format selection", q: "You need to send nested data (a learner with a list of completed courses) between two systems. Which format fits best?", opts: ["CSV", "JSON", "Plain text", "PNG"], a: 1, e: "CSV is flat by design. JSON expresses nesting natively, which is why APIs use it." },
      { t: "sc", c: "Format selection", q: "A CSV import splits one name field into two columns. What is the structural cause?", opts: ["The file is too large", "A comma inside a field was not quoted, so the parser counted extra fields", "The file used UTF-8", "The LMS does not support CSV"], a: 1, e: "Delimiters inside data must be escaped or quoted, otherwise the parser cannot tell data from structure." },
      { t: "mc", c: "Encoding", q: "Which encoding is the sensible modern default for multilingual text?", opts: ["ASCII", "UTF-8", "ISO-8859-1", "Base64"], a: 1, e: "UTF-8 covers the full Unicode range and is the web standard. Base64 is not an encoding for text meaning — it encodes binary as text." },
      { t: "sa", c: "Formats vs extensions", q: "Why can you open a .csv in a text editor but not a .png?", a: { groups: [["text", "teks", "karakter", "character"], ["binary", "biner", "byte"], ["readable", "dibaca", "terbaca"], ["structure", "terstruktur", "struktur"]], need: 2, model: "CSV is a text format: the bytes map to readable characters. PNG is binary, so its bytes only make sense to a program that knows the format." }, e: "The distinction is text format versus binary format." },
