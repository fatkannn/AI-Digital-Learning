    resources: [
      { title: "Tool use overview", source: "Anthropic", topic: "AI Agents", difficulty: "Intermediate", minutes: 40, url: "https://platform.claude.com/docs/en/agents-and-tools/tool-use/overview", verified: true,
        id: { apa: "Dokumentasi resmi tentang cara model meminta pemanggilan tool dan bagaimana hasilnya dikembalikan.",
          inti: ["Definisi tool: nama, deskripsi, skema parameter.", "Model memilih tool berdasarkan deskripsi.", "Aplikasi yang mengeksekusi tool, bukan model.", "Hasil tool dikembalikan ke model sebagai konteks.", "Deskripsi tool yang jelas menentukan keandalan."],
          kenapa: "Tool calling adalah dasar teknis semua agen AI dan integrasi otomatisasi.",
          hubungan: "Menggabungkan API (Day 7), structured output (Day 17), dan konsep agen hari ini. Alamat dokumentasi Anthropic sudah berpindah ke domain platform.claude.com; yang tersimpan di sini adalah alamat barunya, dibuka dan diverifikasi pada sesi back-verification." } },
      { title: "Model Context Protocol", source: "MCP project", topic: "MCP", difficulty: "Intermediate", minutes: 35, url: "https://modelcontextprotocol.io/", verified: true,
        id: { apa: "Situs resmi protokol terbuka untuk menghubungkan model AI dengan sumber data dan tool secara terstandar.",
          inti: ["Arsitektur client dan server.", "Tools, resources, dan prompts sebagai kemampuan server.", "Standarisasi mengurangi integrasi khusus per aplikasi.", "Pertimbangan keamanan dan izin akses."],
          kenapa: "MCP mulai menjadi cara umum menghubungkan asisten AI dengan sistem internal seperti LMS.",
          hubungan: "Kelanjutan langsung dari tool calling; menjadi fokus fase otomatisasi berikutnya." } },
