      { t: "sc", c: "HTML semantics", q: "An accessibility audit reports 'no headings found' on a page that visually has headings. What happened?", opts: ["The CSS file failed to load", "Text was styled to look like headings without using heading elements", "The page uses too much JavaScript", "The images lack alt text"], a: 1, e: "Visual styling is not structure. Only real heading elements appear in the accessibility tree." },
      { t: "mc", c: "DOM", q: "What is the DOM?", opts: ["A database of page content", "The browser's in-memory tree of objects representing the page, which JavaScript can modify", "A CSS layout system", "A server-side rendering engine"], a: 1, e: "The DOM is the live object model of the document, built from HTML and manipulable at runtime." },
      { t: "sa", c: "HTML/CSS/JS roles", q: "Describe the job of CSS in one sentence.", a: { groups: [["style", "gaya", "tampil", "appear", "look", "visual"], ["layout", "tata letak", "letak", "presentation"]], need: 1, model: "CSS controls how elements are presented — layout, typography, colour and spacing — separately from what they mean." }, e: "Presentation layer, kept separate from structure." },
