const CURRICULUM = [...CUR_A, ...CUR_B, ...CUR_C, ...CUR_D, ...CUR_E, ...CUR_F, ...CUR_G];

/* ============================================================================
   LAYER 2 — LOGIC
   Pure functions. Given the saved state, they derive everything the UI shows.
   No component reads raw state directly; it reads what these return.
   ========================================================================== */

const DAY_MS = 86400000;
const dstr = (d = new Date()) => {
  const x = new Date(d.getTime() - d.getTimezoneOffset() * 60000);
  return x.toISOString().slice(0, 10);
};
const diffDays = (a, b) => Math.round((Date.parse(b) - Date.parse(a)) / DAY_MS);
const shiftDate = (iso, n) => dstr(new Date(Date.parse(iso) + n * DAY_MS));
const prettyDate = (iso) =>
  new Date(iso + "T00:00:00").toLocaleDateString(undefined, { weekday: "short", day: "numeric", month: "short" });

const STATE_VERSION = 1;

const EMPTY_STATE = {
  version: STATE_VERSION,
  startDate: dstr(),
  lessons: {},   // dayNumber -> { completedAt, segments: { index: dateISO } }
  tests: {},     // dayNumber -> { attempts: [ { date, pct, correct, total, detail: [...] } ] }
};

/** Coerce a loaded record into the shape the rest of the app assumes.
    Anything unrecognisable is dropped rather than allowed to crash a render.
    Returns { state, dropped } so the caller can tell the user something was lost. */
function normalizeState(raw) {
  const dropped = [];
  if (!raw || typeof raw !== "object") return { state: { ...EMPTY_STATE }, dropped: ["whole record"] };

  const startDate = /^\d{4}-\d{2}-\d{2}$/.test(raw.startDate) ? raw.startDate : dstr();
  if (startDate !== raw.startDate) dropped.push("startDate");

  const isDate = (v) => typeof v === "string" && /^\d{4}-\d{2}-\d{2}$/.test(v);

  const lessons = {};
  Object.entries(raw.lessons && typeof raw.lessons === "object" ? raw.lessons : {}).forEach(([k, v]) => {
    const day = dayByNumber(Number(k));
    if (!day || !v || typeof v !== "object") { dropped.push("lesson " + k); return; }
    const segments = {};
    Object.entries(v.segments && typeof v.segments === "object" ? v.segments : {}).forEach(([i, d]) => {
      if (day.segments[Number(i)] && isDate(d)) segments[Number(i)] = d;
      else dropped.push("lesson " + k + " segment " + i);
    });
    lessons[day.day] = { completedAt: isDate(v.completedAt) ? v.completedAt : null, segments };
  });

  const tests = {};
  Object.entries(raw.tests && typeof raw.tests === "object" ? raw.tests : {}).forEach(([k, v]) => {
    const day = dayByNumber(Number(k));
    if (!day || !v || typeof v !== "object" || !Array.isArray(v.attempts)) { dropped.push("test " + k); return; }
    const attempts = v.attempts.filter((a) => {
      const ok = a && typeof a === "object" && isDate(a.date) && typeof a.pct === "number" && Array.isArray(a.detail);
      if (!ok) dropped.push("test " + k + " attempt");
      return ok;
    }).map((a) => ({
      date: a.date,
      pct: Math.max(0, Math.min(100, Math.round(a.pct))),
      correct: typeof a.correct === "number" ? a.correct : 0,
      total: typeof a.total === "number" ? a.total : day.quiz.length,
      passed: Boolean(a.passed),
      detail: a.detail
        .filter((d) => d && typeof d === "object" && d.concept)
        .map((d, i) => ({ index: typeof d.index === "number" ? d.index : i, concept: String(d.concept), correct: Boolean(d.correct), given: d.given ?? null })),
    }));
    if (attempts.length) tests[day.day] = { attempts };
    else dropped.push("test " + k + " (no usable attempts)");
  });

  return { state: { version: STATE_VERSION, startDate, lessons, tests }, dropped };
}

const dayByNumber = (n) => CURRICULUM.find((d) => d.day === n);
const daysForSub = (subId) => CURRICULUM.filter((d) => d.sub === subId);
const phaseOf = (n) => PHASES.find((p) => n >= p.days[0] && n <= p.days[1]);
const totalMinutes = (day) => day.segments.reduce((s, x) => s + x.m, 0);

function bestPct(state, dayNum) {
  const t = state.tests[dayNum];
  if (!t || !t.attempts.length) return null;
  return Math.max(...t.attempts.map((a) => a.pct));
}
function lessonDone(state, dayNum) {
  return Boolean(state.lessons[dayNum]?.completedAt);
}
/** An attempt exists. This is "has sat the test", NOT "has passed it" — the two were the
    same thing until M14 and the distinction is now load-bearing. UI copy that says
    "submitted" / "retake" reads this; anything that gates progression reads testPassed. */
function testDone(state, dayNum) {
  return Boolean(state.tests[dayNum]?.attempts.length);
}
/** The qualifying pass. Measured on bestPct, not on the latest attempt and not on the
    stored `passed` flag: credit already keeps best-of, so a later weak retake must not be
    able to take away a day the learner has already earned. The stored flag is deliberately
    ignored because a hand-edited or legacy record could carry `passed: true` at 0%. */
function testPassed(state, dayNum) {
  const pct = bestPct(state, dayNum);
  return pct !== null && pct >= CONFIG.passThreshold;
}
/** M14: a day needs the lesson AND a post-test score at or above the pass mark.
    Before M14 any submitted attempt counted, so a 0% completed the day and unlocked the
    next one while the interface said "Pass mark 70%". */
function dayCompleted(state, dayNum) {
  return lessonDone(state, dayNum) && testPassed(state, dayNum);
}
/** Locked / not-started / in-progress / completed. Day N unlocks when N-1 is completed. */
function dayStatus(state, dayNum) {
  if (dayNum > 1 && !dayCompleted(state, dayNum - 1)) return "locked";
  if (dayCompleted(state, dayNum)) return "completed";
  const l = state.lessons[dayNum];
  if (l?.completedAt || (l && Object.keys(l.segments || {}).length)) return "in-progress";
  return "not-started";
}
/** The first unlocked day that is not finished — what "today" points at. */
function activeDayNumber(state) {
  const next = CURRICULUM.find((d) => !dayCompleted(state, d.day));
  return next ? next.day : CURRICULUM[CURRICULUM.length - 1].day;
}
/** The date a day became fully complete (lesson + a passing post-test).
    M14: the qualifying event is the FIRST attempt that reached the pass mark, not
    attempts[0]. Fail-then-pass must date the completion to the pass, or a day the learner
    had not yet earned would back-date into the streak. Pass-then-fail keeps the original
    date, because the day was already earned and a weak retake does not un-earn it. */
function completionDate(state, dayNum) {
  if (!dayCompleted(state, dayNum)) return null;
  const l = state.lessons[dayNum].completedAt;
  const attempts = state.tests[dayNum].attempts;
  const qualifying = attempts.find((a) => a.pct >= CONFIG.passThreshold) || attempts[0];
  const t = qualifying.date;
  return l > t ? l : t;
}
function completionDates(state) {
  return CURRICULUM.map((d) => completionDate(state, d.day)).filter(Boolean);
}

function streakStats(state) {
  const all = [...new Set(completionDates(state))].sort();
  const today = dstr();
  // A completion cannot legitimately be dated in the future. It happens when the device
  // clock is wrong or a record was hand-edited. The day still counts as completed, but a
  // future date must not prop up a streak: diffDays would return a negative gap, which the
  // old `gap <= 1` test accepted. Such dates are excluded from streak maths and surfaced.
  const future = all.filter((d) => d > today);
  const dates = all.filter((d) => d <= today);
  if (!dates.length) return { current: 0, longest: 0, total: all.length, todayDone: false, future: future.length };
  let longest = 1, run = 1;
  for (let i = 1; i < dates.length; i++) {
    run = diffDays(dates[i - 1], dates[i]) === 1 ? run + 1 : 1;
    if (run > longest) longest = run;
  }
  const gap = diffDays(dates[dates.length - 1], today);
  let current = 0;
  if (gap >= 0 && gap <= 1) {
    current = 1;
    for (let i = dates.length - 1; i > 0; i--) {
      if (diffDays(dates[i - 1], dates[i]) === 1) current++;
      else break;
    }
  }
  return { current, longest, total: all.length, todayDone: dates.includes(today), future: future.length };
}

/** Minutes studied per calendar date, from checked-off lesson segments. */
function minutesByDate(state) {
  const map = {};
  Object.entries(state.lessons).forEach(([dayNum, l]) => {
    const day = dayByNumber(Number(dayNum));
    if (!day) return;
    Object.entries(l.segments || {}).forEach(([idx, date]) => {
      const seg = day.segments[Number(idx)];
      if (!seg) return;
      map[date] = (map[date] || 0) + seg.m;
    });
  });
  return map;
}
const minutesToday = (state) => minutesByDate(state)[dstr()] || 0;

/** Knowledge credit earned for one day: lesson share + test share scaled by score. */
function dayCredit(state, dayNum) {
  let credit = 0;
  if (lessonDone(state, dayNum)) credit += CONFIG.lessonWeight;
  const pct = bestPct(state, dayNum);
  if (pct !== null) credit += CONFIG.testWeight * (pct / 100);
  return credit;
}

/** Progress per subcategory, then per domain, then overall — all derived, never stored. */
function knowledgeProgress(state) {
  const subs = {};
  Object.values(SUB_INDEX).forEach((sub) => {
    const days = daysForSub(sub.id);
    const target = Math.max(sub.target, days.length);
    const earned = days.reduce((s, d) => s + dayCredit(state, d.day), 0);
    const scores = days.map((d) => bestPct(state, d.day)).filter((x) => x !== null);
    const avg = scores.length ? Math.round(scores.reduce((a, b) => a + b, 0) / scores.length) : null;
    subs[sub.id] = {
      ...sub,
      pct: Math.min(100, Math.round((earned / target) * 100)),
      // Same credit, measured against the days that actually exist. Null when none are written.
      pctWritten: days.length ? Math.min(100, Math.round((earned / days.length) * 100)) : null,
      daysPlanned: days.length,
      daysDone: days.filter((d) => dayCompleted(state, d.day)).length,
      target,
      avgScore: avg,
      mastery: avg === null ? (earned > 0 ? "Lesson done, not tested" : "Not started") : avg >= 90 ? "Strong mastery" : avg >= 80 ? "Good understanding" : avg >= CONFIG.passThreshold ? "Basic mastery" : "Needs review",
    };
  });
  const domains = DOMAINS.map((d) => ({
    ...d,
    pct: Math.round(d.subs.reduce((s, x) => s + subs[x.id].pct, 0) / d.subs.length),
    subs: d.subs.map((x) => subs[x.id]),
  }));
  const overall = Math.round(domains.reduce((s, d) => s + d.pct, 0) / domains.length);
  // Two honest denominators, not one. `overall` measures the full roadmap in DOMAINS —
  // it cannot reach 100% until every planned day is written. `written` measures only the
  // days that exist today, so finishing everything available reads 100%.
  const earnedAll = CURRICULUM.reduce((s, d) => s + dayCredit(state, d.day), 0);
  const written = Math.min(100, Math.round((earnedAll / CURRICULUM.length) * 100));
  const subsWritten = Object.values(subs).filter((s) => s.daysPlanned > 0).length;
  return {
    subs, domains, overall, written,
    daysWritten: CURRICULUM.length,
    subsWritten, subsTotal: Object.keys(subs).length,
    ai: domains.find((d) => d.id === "ai").pct,
  };
}

/** Concept-level accuracy from the MOST RECENT attempt of each day.
    Deliberately different from bestPct, which takes the best attempt: credit rewards the
    mastery you have reached, review reflects where you stand right now. Averaging every
    attempt ever — the original behaviour — meant a perfect retake could not clear a flag. */
function conceptStats(state) {
  const map = {};
  Object.entries(state.tests).forEach(([dayNum, t]) => {
    const a = t.attempts[t.attempts.length - 1];
    if (!a) return;
    a.detail.forEach((q) => {
      const k = q.concept;
      if (!map[k]) map[k] = { concept: k, attempted: 0, correct: 0, days: new Set(), lastSeen: a.date };
      map[k].attempted++;
      if (q.correct) map[k].correct++;
      map[k].days.add(Number(dayNum));
      if (a.date > map[k].lastSeen) map[k].lastSeen = a.date;
    });
  });
  return Object.values(map).map((c) => ({
    ...c,
    days: [...c.days],
    accuracy: Math.round((c.correct / c.attempted) * 100),
  }));
}
function reviewItems(state) {
  return conceptStats(state)
    .filter((c) => c.attempted >= CONFIG.reviewMinQuestions && c.accuracy < CONFIG.reviewThreshold)
    .sort((a, b) => a.accuracy - b.accuracy);
}

/** Grading. Short answers are keyword-matched — imperfect, and labelled as such in the UI. */
/** Two answer shapes are supported for short answers:
      { groups: [[synonym, ...], ...], need: n }  each group is ONE idea. Matching several
          synonyms inside a group still counts once, so restating a single idea three ways
          cannot satisfy need: 2. Synonyms may be in any language, which is why an answer
          written in Indonesian scores the same as the equivalent English answer.
      { keywords: [...], need: n }  legacy flat list; every keyword counted separately.
    Matching is case-insensitive substring, so entries should be stems ("permanen" also
    matches "permanent") and must not occur inside unrelated words. */
function gradeQuestion(q, given) {
  if (given === undefined || given === null || given === "") return false;
  if (q.t === "tf") return given === q.a;
  if (q.t === "sa") {
    const text = String(given).toLowerCase();
    if (Array.isArray(q.a.groups)) {
      const ideas = q.a.groups.filter((g) => g.some((k) => text.includes(String(k).toLowerCase()))).length;
      return ideas >= q.a.need;
    }
    const hits = q.a.keywords.filter((k) => text.includes(String(k).toLowerCase())).length;
    return hits >= q.a.need;
  }
  return given === q.a;
}
function gradeTest(day, answers) {
  const detail = day.quiz.map((q, i) => {
    const correct = gradeQuestion(q, answers[i]);
    return { index: i, concept: q.c, correct, given: answers[i] ?? null };
  });
  const correct = detail.filter((d) => d.correct).length;
  const total = day.quiz.length;
  const pct = Math.round((correct / total) * 100);
  return { date: dstr(), correct, total, pct, passed: pct >= CONFIG.passThreshold, detail };
}

/* ============================================================================
   LAYER 3 — UI
   Presentational pieces first, then one view per navigation item.
   ========================================================================== */

const STORAGE_KEY = "ai-learning-os-v1";
const BACKUP_KEY_PREFIX = "ai-learning-os-backup-";

const TONE = {
  blue: { bar: "bg-blue-700", soft: "bg-blue-50", text: "text-blue-700", ring: "ring-blue-200" },
  emerald: { bar: "bg-emerald-600", soft: "bg-emerald-50", text: "text-emerald-700", ring: "ring-emerald-200" },
  orange: { bar: "bg-orange-500", soft: "bg-orange-50", text: "text-orange-700", ring: "ring-orange-200" },
  rose: { bar: "bg-rose-600", soft: "bg-rose-50", text: "text-rose-700", ring: "ring-rose-200" },
  slate: { bar: "bg-slate-400", soft: "bg-slate-100", text: "text-slate-600", ring: "ring-slate-200" },
};

// tone="dark" is for the slate-900 cards: slate-500 reaches only 3.75:1 there, while
// slate-300 reaches 12:1. On white, slate-500 is 4.76:1 and slate-400 was only 2.56:1,
// which failed WCAG AA for the section labels, question-type labels and the footer.
function Eyebrow({ children, className = "", tone = "light" }) {
  const colour = tone === "dark" ? "text-slate-300" : "text-slate-500";
  return <p className={"text-xs font-semibold uppercase tracking-widest " + colour + " " + className}>{children}</p>;
}

function Bar({ pct, tone = "blue", height = "h-2" }) {
  return (
    <div className={"w-full rounded-full bg-slate-200 " + height} role="presentation">
      <div className={"rounded-full transition-all duration-500 " + TONE[tone].bar + " " + height} style={{ width: Math.max(pct, 0) + "%" }} />
    </div>
  );
}

function Pill({ children, tone = "slate", icon: Icon }) {
  return (
    <span className={"inline-flex items-center gap-1 rounded-full px-2.5 py-1 text-xs font-medium " + TONE[tone].soft + " " + TONE[tone].text}>
      {Icon ? <Icon className="h-3.5 w-3.5" /> : null}
      {children}
    </span>
  );
}

function Button({ children, onClick, variant = "primary", size = "md", disabled, icon: Icon, className = "" }) {
  const base = "inline-flex items-center justify-center gap-2 rounded-lg font-medium transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 focus-visible:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-40";
  const sizes = { sm: "px-3 py-1.5 text-sm", md: "px-4 py-2.5 text-sm", lg: "px-5 py-3 text-base" };
  const variants = {
    primary: "bg-blue-700 text-white hover:bg-blue-800",
    ghost: "text-slate-700 hover:bg-slate-100",
    outline: "border border-slate-300 bg-white text-slate-700 hover:bg-slate-50",
    danger: "border border-rose-200 bg-white text-rose-700 hover:bg-rose-50",
  };
  return (
    <button type="button" onClick={onClick} disabled={disabled} className={[base, sizes[size], variants[variant], className].join(" ")}>
      {Icon ? <Icon className="h-4 w-4" /> : null}
      {children}
    </button>
  );
}

function Card({ children, className = "" }) {
  return <div className={"rounded-xl border border-slate-200 bg-white " + className}>{children}</div>;
}

/* The signature element: the hour, drawn to scale. Each block is one segment of
   the 60-minute session, sized by its minutes and checked off as you work. */
function HourRibbon({ day, checked = {}, onToggle, compact = false }) {
  const total = totalMinutes(day);
  let elapsed = 0;
  return (
    <div className="w-full">
      <div className={"flex w-full gap-1 " + (compact ? "h-2.5" : "h-3")}>
        {day.segments.map((s, i) => {
          const on = checked[i] !== undefined;
          return (
            <button
              key={i}
              type="button"
              disabled={!onToggle}
              onClick={() => onToggle && onToggle(i)}
              title={s.t + " · " + s.m + " min"}
              aria-label={s.t + ", " + s.m + " minutes" + (onToggle ? (on ? ", done" : ", not done") : "")}
              aria-pressed={onToggle ? on : undefined}
              className={
                "h-full rounded-full transition-colors " +
                (on ? "bg-blue-700" : "bg-slate-200") +
                (onToggle ? " hover:bg-blue-400 focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-500" : "")
              }
              style={{ flexGrow: s.m, flexBasis: 0 }}
            />
          );
        })}
      </div>
      {!compact && (
        <div className="mt-2 flex w-full gap-1">
          {day.segments.map((s, i) => {
            const start = elapsed;
            elapsed += s.m;
            return (
              <div key={i} className="min-w-0" style={{ flexGrow: s.m, flexBasis: 0 }}>
                <p className="truncate text-xs font-medium text-slate-600">{s.t}</p>
                <p className="text-xs tabular-nums text-slate-500">{start}–{elapsed}</p>
              </div>
            );
          })}
        </div>
      )}
    </div>
  );
}

const STATUS_META = {
  completed: { label: "Completed", tone: "emerald", icon: CheckCircle2 },
  "in-progress": { label: "In progress", tone: "blue", icon: Circle },
  "not-started": { label: "Not started", tone: "slate", icon: Circle },
  locked: { label: "Locked", tone: "slate", icon: Lock },
};

function StatTile({ icon: Icon, label, value, sub, tone = "slate" }) {
  return (
    <Card className="p-4">
      <div className="flex items-center gap-2">
        <Icon className={"h-4 w-4 " + TONE[tone].text} />
        <p className="text-xs font-medium uppercase tracking-wide text-slate-500">{label}</p>
      </div>
      <p className={"mt-2 font-semibold tabular-nums tracking-tight text-slate-900 " + (String(value).length > 11 ? "text-lg" : "text-2xl")}>{value}</p>
      {sub ? <p className="mt-0.5 text-xs text-slate-500">{sub}</p> : null}
    </Card>
  );
}

function ResourceCard({ r }) {
  const [open, setOpen] = useState(false);
  return (
    <Card className="overflow-hidden">
      <div className="p-4">
        <div className="flex flex-wrap items-start justify-between gap-3">
          <div className="min-w-0">
            <p className="font-semibold leading-snug text-slate-900">{r.title}</p>
            <p className="mt-0.5 text-sm text-slate-500">{r.source}</p>
          </div>
          {r.verified ? <Pill tone="emerald">Curated</Pill> : <Pill tone="orange" icon={AlertTriangle}>Needs verification</Pill>}
        </div>
        <div className="mt-3 flex flex-wrap items-center gap-2 text-xs text-slate-500">
          <span className="rounded bg-slate-100 px-2 py-1">{r.topic}</span>
          <span className="rounded bg-slate-100 px-2 py-1">{r.difficulty}</span>
          <span className="inline-flex items-center gap-1 rounded bg-slate-100 px-2 py-1"><Clock className="h-3 w-3" />{r.minutes} min</span>
        </div>
        <div className="mt-4 flex flex-wrap gap-2">
          <Button size="sm" variant="outline" icon={FileText} onClick={() => setOpen((v) => !v)}>
            {open ? "Hide Indonesian summary" : "Ringkasan Bahasa Indonesia"}
          </Button>
          <a href={r.url} target="_blank" rel="noopener noreferrer"
            className="inline-flex items-center justify-center gap-2 rounded-lg bg-blue-700 px-3 py-1.5 text-sm font-medium text-white transition-colors hover:bg-blue-800 focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 focus-visible:ring-offset-2">
            Open original source <ExternalLink className="h-3.5 w-3.5" />
          </a>
        </div>
      </div>
      {open && (
        <div className="border-t border-slate-200 bg-slate-50 p-4 text-sm leading-relaxed text-slate-700">
          <p className="text-xs font-semibold uppercase tracking-wide text-slate-500">Apa yang akan dipelajari?</p>
          <p className="mt-1">{r.id.apa}</p>
          <p className="mt-4 text-xs font-semibold uppercase tracking-wide text-slate-500">Inti materi</p>
          <ul className="mt-1 list-disc space-y-1 pl-5">
            {r.id.inti.map((x, i) => <li key={i}>{x}</li>)}
          </ul>
          <p className="mt-4 text-xs font-semibold uppercase tracking-wide text-slate-500">Kenapa penting?</p>
          <p className="mt-1">{r.id.kenapa}</p>
          <p className="mt-4 text-xs font-semibold uppercase tracking-wide text-slate-500">Hubungannya dengan materi sebelumnya</p>
          <p className="mt-1">{r.id.hubungan}</p>
          <p className="mt-4 text-xs text-slate-500">Ringkasan ini ditulis ulang sebagai catatan belajar, bukan terjemahan sumber aslinya. Buka sumber asli untuk detail lengkap.</p>
        </div>
      )}
    </Card>
  );
}

/* --- Lesson view ---------------------------------------------------------- */

function LessonView({ day, state, onToggleSegment, onCompleteLesson, onStartTest, onBack }) {
  const checked = state.lessons[day.day]?.segments || {};
  const done = lessonDone(state, day.day);
  const testTaken = testDone(state, day.day);
  const testCleared = testPassed(state, day.day);
  const best = bestPct(state, day.day);
  const sub = SUB_INDEX[day.sub];
  const doneCount = Object.keys(checked).length;

  return (
    <div className="mx-auto max-w-3xl">
      <button onClick={onBack} className="mb-4 inline-flex items-center gap-1 text-sm font-medium text-slate-500 hover:text-slate-900">
        <ChevronLeft className="h-4 w-4" /> Back to dashboard
      </button>

      <Eyebrow>Day {day.day} · {phaseOf(day.day)?.label}</Eyebrow>
      <h1 className="mt-1 text-2xl font-semibold tracking-tight text-slate-900 sm:text-3xl">{day.title}</h1>
      <div className="mt-3 flex flex-wrap items-center gap-2">
        <Pill tone="blue">{sub.label}</Pill>
        <Pill icon={Clock}>{totalMinutes(day)} minutes</Pill>
        {done ? <Pill tone="emerald" icon={CheckCircle2}>Learning complete</Pill> : null}
      </div>

      <Card className="mt-6 p-5">
        <div className="flex items-baseline justify-between">
          <p className="text-sm font-semibold text-slate-900">Your hour</p>
          <p className="text-xs tabular-nums text-slate-500">{doneCount} of {day.segments.length} segments checked</p>
        </div>
        <p className="mb-3 mt-1 text-xs text-slate-500">Tap a block when you finish that part. Checked minutes count towards today's total.</p>
        <HourRibbon day={day} checked={checked} onToggle={onToggleSegment} />
      </Card>

      <Card className="mt-4 p-5">
        <Eyebrow>Learning objectives</Eyebrow>
        <ul className="mt-2 space-y-2">
          {day.objectives.map((o, i) => (
            <li key={i} className="flex gap-2 text-sm text-slate-700">
              <Target className="mt-0.5 h-4 w-4 shrink-0 text-blue-700" />{o}
            </li>
          ))}
        </ul>
      </Card>

      <h2 className="mt-8 text-lg font-semibold tracking-tight text-slate-900">Learn</h2>
      <div className="mt-3 space-y-3">
        {day.segments.map((s, i) => {
          const on = checked[i] !== undefined;
          return (
            <Card key={i} className={on ? "border-blue-200 bg-blue-50 p-5" : "p-5"}>
              <div className="flex items-start justify-between gap-4">
                <div>
                  <p className="text-xs font-semibold uppercase tracking-wide text-slate-500">{s.m} min</p>
                  <p className="font-semibold text-slate-900">{s.t}</p>
                </div>
                <button onClick={() => onToggleSegment(i)} className="shrink-0 rounded-full p-1 focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-500" aria-label={on ? "Mark segment unfinished" : "Mark segment finished"}>
                  {on ? <CheckCircle2 className="h-6 w-6 text-blue-700" /> : <Circle className="h-6 w-6 text-slate-300" />}
                </button>
              </div>
              <div className="mt-3 space-y-3">
                {s.body.map((p, j) => <p key={j} className="text-sm leading-relaxed text-slate-700">{p}</p>)}
              </div>
            </Card>
          );
        })}
      </div>

      {day.recap ? (
        <>
          <h2 className="mt-8 text-lg font-semibold tracking-tight text-slate-900">Cek pemahaman</h2>
          <p className="mt-1 text-sm text-slate-500">Rangkuman Bahasa Indonesia. Dibaca setelah materi di atas, bukan sebagai penggantinya — kalau isinya terasa asing, materinya belum nempel.</p>
          {/* Deliberately not a <Card>: Card hardcodes bg-white, and two competing background
              utilities in one class string do not resolve reliably (see M6). */}
          <div className="mt-3 rounded-xl border border-amber-200 border-l-4 border-l-amber-500 bg-amber-50 p-5">
            <p className="text-xs font-semibold uppercase tracking-widest text-slate-600">Inti hari ini</p>
            <p className="mt-1 text-sm leading-relaxed text-slate-700">{day.recap.inti}</p>
            <p className="mt-4 text-xs font-semibold uppercase tracking-widest text-slate-600">Salah paham yang harus dihindari</p>
            <p className="mt-1 text-sm leading-relaxed text-slate-700">{day.recap.salahPaham}</p>
            <p className="mt-4 text-xs font-semibold uppercase tracking-widest text-slate-600">Peta istilah</p>
            <dl className="mt-2 space-y-2">
              {day.recap.istilah.map((t, i) => (
                <div key={i} className="text-sm leading-relaxed">
                  <dt className="inline font-semibold text-slate-900">{t.en}</dt>
                  <dd className="inline text-slate-700"> — {t.id}</dd>
                </div>
              ))}
            </dl>
            <p className="mt-4 text-xs leading-relaxed text-slate-600">Istilah Inggrisnya sengaja dipertahankan: itu yang dipakai di dokumentasi dan di tempat kerja.</p>
          </div>
        </>
      ) : null}

      <h2 className="mt-8 text-lg font-semibold tracking-tight text-slate-900">Example</h2>
      <Card className="mt-3 border-l-4 border-l-blue-700 p-5">
        <p className="font-semibold text-slate-900">{day.example.t}</p>
        <p className="mt-2 text-sm leading-relaxed text-slate-700">{day.example.body}</p>
      </Card>

      <h2 className="mt-8 text-lg font-semibold tracking-tight text-slate-900">Practice</h2>
      <Card className="mt-3 p-5">
        <p className="font-semibold text-slate-900">{day.practice.t}</p>
        <ol className="mt-3 space-y-2">
          {day.practice.steps.map((s, i) => (
            <li key={i} className="flex gap-3 text-sm text-slate-700">
              <span className="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-slate-100 text-xs font-semibold tabular-nums text-slate-600">{i + 1}</span>
              {s}
            </li>
          ))}
        </ol>
      </Card>

      <h2 className="mt-8 text-lg font-semibold tracking-tight text-slate-900">Challenge</h2>
      <Card className="mt-3 bg-slate-900 p-5">
        <p className="text-sm leading-relaxed text-slate-100">{day.challenge}</p>
        <p className="mt-3 text-xs text-slate-300">Attempt this before reading any solution. Getting it wrong first is part of the method.</p>
      </Card>

      <h2 className="mt-8 text-lg font-semibold tracking-tight text-slate-900">Resources</h2>
      <p className="mt-1 text-sm text-slate-500">Read at least one before the post-test. Each has an Indonesian study summary; the original stays one click away.</p>
      <div className="mt-3 space-y-3">
        {day.resources.map((r, i) => <ResourceCard key={i} r={r} />)}
      </div>

      <Card className="mt-8 p-5">
        {!done ? (
          <>
            <p className="font-semibold text-slate-900">Finished the hour?</p>
            <p className="mt-1 text-sm text-slate-600">Marking the lesson complete unlocks the post-test. The two are separate steps: the day only counts once you score at least {CONFIG.passThreshold}% on the test.</p>
            <Button className="mt-4" size="lg" icon={CheckCircle2} onClick={onCompleteLesson}>Complete learning</Button>
          </>
        ) : (
          <>
            <p className="font-semibold text-slate-900">
              {!testTaken ? "Post-test unlocked" : testCleared ? "Post-test passed" : "Post-test not passed yet"}
            </p>
            <p className="mt-1 text-sm text-slate-600">
              {!testTaken
                ? day.quiz.length + " questions on today's material only. Passing mark is " + CONFIG.passThreshold + "%."
                : testCleared
                ? "Best score " + best + "%. The day is complete. You can retake it — the best score is what counts, so a weaker retake cannot undo this."
                : "Best score so far " + best + "%, below the " + CONFIG.passThreshold + "% pass mark, so this day is not complete and the next day is still locked. Retake when you are ready."}
            </p>
            {testTaken && !testCleared && (
              <p className="mt-1 text-sm text-slate-600"><span className="font-medium text-slate-900">Belum lulus.</span> Nilai minimal {CONFIG.passThreshold}% untuk menyelesaikan hari ini.</p>
            )}
            <Button className="mt-4" size="lg" icon={GraduationCap} onClick={onStartTest}>{testTaken ? "Retake post-test" : "Start post-test"}</Button>
          </>
        )}
      </Card>
    </div>
  );
}

/* --- Post-test view ------------------------------------------------------- */

function TestView({ day, state, onSubmit, onBack }) {
  const [answers, setAnswers] = useState({});
  const [result, setResult] = useState(null);
  const answered = Object.keys(answers).filter((k) => answers[k] !== "" && answers[k] !== undefined).length;

  const submit = () => {
    const r = gradeTest(day, answers);
    setResult(r);
    onSubmit(r);
    window.scrollTo({ top: 0, behavior: "smooth" });
  };
  const retake = () => { setAnswers({}); setResult(null); };

  const set = (i, v) => setAnswers((a) => ({ ...a, [i]: v }));

  if (result) {
    const weak = [...new Set(result.detail.filter((d) => !d.correct).map((d) => d.concept))];
    // `state` already contains the attempt just submitted, so when this attempt failed and
    // the day is still passed, an earlier attempt must have carried it. That is the
    // pass-then-failed-retake case, and it must not read as a loss.
    const earnedBest = bestPct(state, day.day);
    const alreadyEarned = testPassed(state, day.day);
    return (
      <div className="mx-auto max-w-3xl">
        <Eyebrow>Day {day.day} · post-test result</Eyebrow>
        <h1 className="mt-1 text-2xl font-semibold tracking-tight text-slate-900">{day.title}</h1>

        <Card className="mt-5 p-6" role="status" aria-live="polite">
          <div className="flex flex-wrap items-end justify-between gap-4">
            <div>
              <p className="text-4xl font-semibold tabular-nums tracking-tight text-slate-900">{result.correct}<span className="text-slate-500">/{result.total}</span></p>
              <p className="mt-1 text-sm text-slate-500">{result.pct}% · {result.total - result.correct} incorrect</p>
            </div>
            {result.passed
              ? <Pill tone="emerald" icon={Award}>Passed · threshold {CONFIG.passThreshold}%</Pill>
              : <Pill tone="orange" icon={AlertTriangle}>Not passed · needs {CONFIG.passThreshold}%</Pill>}
          </div>
          <div className="mt-4"><Bar pct={result.pct} tone={result.passed ? "emerald" : "orange"} height="h-2.5" /></div>
          {/* M14: what this paragraph says is now the actual rule, not a description of one.
              Before M14 a failed test still completed the day, so the reassuring copy here was
              true and the "Pass mark 70%" line on the previous screen was the lie. */}
          <p className="mt-4 text-sm text-slate-600">
            {alreadyEarned && !result.passed
              ? "This retake is below " + CONFIG.passThreshold + "%, but the day stays complete — your best score of " + earnedBest + "% already counted and retaking can never cost you a day you have earned."
              : result.passed
              ? "The day is recorded and your knowledge progress has been updated. Progress moves gradually — one strong score does not complete a topic."
              : "The day is not complete yet and the next day stays locked. Retake the post-test when you are ready — your attempt is kept, and the best score is the one that counts."}
          </p>
          {/* Indonesian gloss at the point comprehension actually decides something, matching
              the targeted-Indonesian pattern established for the lesson recap in M7. */}
          <p className="mt-2 text-sm text-slate-600">
            {alreadyEarned && !result.passed
              ? <><span className="font-medium text-slate-900">Hari ini tetap selesai.</span> Nilai terbaik Anda ({earnedBest}%) yang dipakai, jadi mengulang tes tidak pernah membatalkan hari yang sudah Anda peroleh.</>
              : result.passed
              ? <><span className="font-medium text-slate-900">Lulus.</span> Hari ini selesai dan hari berikutnya terbuka.</>
              : <><span className="font-medium text-slate-900">Belum lulus.</span> Nilai minimal {CONFIG.passThreshold}%. Hari ini belum selesai dan hari berikutnya masih terkunci — silakan ulangi post-test.</>}
          </p>
          {weak.length > 0 && (
            <div className="mt-4 rounded-lg bg-orange-50 p-4">
              <p className="text-sm font-semibold text-orange-800">You need more practice with:</p>
              <ul className="mt-2 flex flex-wrap gap-2">
                {weak.map((w) => <li key={w}><Pill tone="orange">{w}</Pill></li>)}
              </ul>
            </div>
          )}
        </Card>

        <h2 className="mt-8 text-lg font-semibold tracking-tight text-slate-900">Answer review</h2>
        <div className="mt-3 space-y-3">
          {day.quiz.map((q, i) => {
            const d = result.detail[i];
            const answerText =
              q.t === "tf" ? (q.a ? "True" : "False")
              : q.t === "sa" ? q.a.model
              : q.opts[q.a];
            return (
              <Card key={i} className={"p-5 " + (d.correct ? "border-emerald-200" : "border-rose-200")}>
                <div className="flex items-start gap-3">
                  {d.correct ? <CheckCircle2 className="mt-0.5 h-5 w-5 shrink-0 text-emerald-700" /> : <X className="mt-0.5 h-5 w-5 shrink-0 text-rose-700" />}
                  <div className="min-w-0">
                    <p className="text-sm font-medium text-slate-900">{q.q}</p>
                    <p className="mt-2 text-sm text-slate-500">Your answer: <span className="text-slate-700">{
                      d.given === null || d.given === "" ? "—"
                      : q.t === "tf" ? (d.given ? "True" : "False")
                      : q.t === "sa" ? String(d.given)
                      : q.opts[d.given]
                    }</span></p>
                    <p className="mt-1 text-sm text-slate-500">{q.t === "sa" ? "Model answer" : "Correct answer"}: <span className="font-medium text-slate-900">{answerText}</span></p>
                    <p className="mt-2 text-sm leading-relaxed text-slate-600">{q.e}</p>
                    <p className="mt-2 text-xs text-slate-500">Concept: {q.c}</p>
                  </div>
                </div>
              </Card>
            );
          })}
        </div>

        <div className="mt-6 flex flex-wrap gap-3">
          <Button icon={ArrowRight} onClick={onBack}>Back to dashboard</Button>
          <Button variant="outline" icon={RotateCcw} onClick={retake}>Retake test</Button>
        </div>
      </div>
    );
  }

  return (
    <div className="mx-auto max-w-3xl">
      <button onClick={onBack} className="mb-4 inline-flex items-center gap-1 text-sm font-medium text-slate-500 hover:text-slate-900">
        <ChevronLeft className="h-4 w-4" /> Leave test
      </button>
      <Eyebrow>Day {day.day} · post-test</Eyebrow>
      <h1 className="mt-1 text-2xl font-semibold tracking-tight text-slate-900">{day.title}</h1>
      <p className="mt-2 text-sm text-slate-600">{day.quiz.length} questions on today's material only. Pass mark {CONFIG.passThreshold}% — <span className="font-medium text-slate-900">the day is only complete once you reach it</span>, and you can retake as often as you like. Short answers are checked for key ideas, so phrase them in your own words — <span className="font-medium text-slate-900">English or Bahasa Indonesia, both are marked the same</span>.</p>

      <div className="mt-6 space-y-4">
        {day.quiz.map((q, i) => (
          <Card key={i} className="p-5">
            <div className="flex items-start gap-3">
              <span className="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-slate-900 text-xs font-semibold tabular-nums text-white">{i + 1}</span>
              <div className="min-w-0 flex-1">
                <p id={"q" + i + "-label"} className="text-sm font-medium leading-relaxed text-slate-900">{q.q}</p>
                <p className="mt-1 text-xs uppercase tracking-wide text-slate-500">
                  {q.t === "mc" ? "Multiple choice" : q.t === "tf" ? "True or false" : q.t === "sc" ? "Scenario" : "Short answer"}
                </p>

                {(q.t === "mc" || q.t === "sc") && (
                  <div className="mt-3 space-y-2" role="radiogroup" aria-labelledby={"q" + i + "-label"}>
                    {q.opts.map((o, oi) => (
                      <label key={oi} className={"flex cursor-pointer items-start gap-3 rounded-lg border p-3 text-sm transition-colors " + (answers[i] === oi ? "border-blue-600 bg-blue-50" : "border-slate-200 hover:bg-slate-50")}>
                        <input type="radio" name={"q" + i} checked={answers[i] === oi} onChange={() => set(i, oi)} className="mt-0.5 h-4 w-4 accent-blue-700" />
                        <span className="text-slate-700">{o}</span>
                      </label>
                    ))}
                  </div>
                )}

                {q.t === "tf" && (
                  <div className="mt-3 flex gap-2" role="group" aria-labelledby={"q" + i + "-label"}>
                    {[true, false].map((v) => (
                      <button key={String(v)} type="button" onClick={() => set(i, v)} aria-pressed={answers[i] === v}
                        className={"rounded-lg border px-4 py-2 text-sm font-medium transition-colors " + (answers[i] === v ? "border-blue-600 bg-blue-50 text-blue-800" : "border-slate-200 text-slate-700 hover:bg-slate-50")}>
                        {v ? "True" : "False"}
                      </button>
                    ))}
                  </div>
                )}

                {q.t === "sa" && (
                  <textarea rows={3} value={answers[i] || ""} onChange={(e) => set(i, e.target.value)}
                    aria-labelledby={"q" + i + "-label"}
                    placeholder="Your own words — English or Bahasa Indonesia..."
                    className="mt-3 w-full rounded-lg border border-slate-300 p-3 text-sm text-slate-800 focus:border-blue-600 focus:outline-none focus:ring-1 focus:ring-blue-600" />
                )}
              </div>
            </div>
          </Card>
        ))}
      </div>

      <div className="sticky bottom-0 mt-6 flex flex-wrap items-center justify-between gap-3 rounded-xl border border-slate-200 bg-white p-4 backdrop-blur">
        <p className="text-sm text-slate-500 tabular-nums">{answered} of {day.quiz.length} answered</p>
        <Button size="lg" icon={GraduationCap} onClick={submit} disabled={answered === 0}>Submit test</Button>
      </div>
    </div>
  );
}

/* --- Dashboard home ------------------------------------------------------- */

function DashboardView({ state, derived, onOpenLesson, onOpenTest, onGo }) {
  const { streak, progress, review, active } = derived;
  const day = active;
  const status = dayStatus(state, day.day);
  const sub = SUB_INDEX[day.sub];
  const days = daysForSub(day.sub);
  const target = Math.max(sub.target, days.length);
  const earnedNow = days.reduce((s, d) => s + dayCredit(state, d.day), 0);
  const projected = Math.min(100, Math.round(((earnedNow - dayCredit(state, day.day) + 1) / target) * 100));
  const mins = minutesToday(state);
  const checked = state.lessons[day.day]?.segments || {};
  const allWritten = CURRICULUM.every((d) => dayCompleted(state, d.day));

  return (
    <div className="space-y-6">
      {/* Every other view opens with an h1; without one here a screen reader lands on a
          page whose first heading is an h2, and the document has no title at all. */}
      <h1 className="sr-only">Dashboard</h1>
      <div className="grid grid-cols-2 gap-3 lg:grid-cols-5">
        <StatTile icon={Flame} tone="orange" label="Current streak" value={streak.current + (streak.current === 1 ? " day" : " days")} sub={"Longest " + streak.longest} />
        <StatTile icon={CalendarDays} label="Learning days" value={streak.total} sub={"of " + CURRICULUM.length + " planned"} />
        <StatTile icon={Clock} tone="blue" label="Today" value={mins + " / " + CONFIG.dailyMinutes + " min"} sub={streak.todayDone ? "Day complete" : "In progress"} />
        <StatTile icon={BarChart3} tone="emerald" label="Curriculum written so far" value={progress.written + "%"} sub={"Full roadmap " + progress.overall + "%"} />
        <StatTile icon={BookOpen} label="Current topic" value={sub.label} sub={phaseOf(day.day)?.label.split("—")[0].trim()} />
      </div>

      {allWritten ? (
        /* Every written day is finished. Showing the last day as "today's learning" forever
           is wrong twice: it presents finished work as pending, and it implies the roadmap is
           done when it is not. This card says what is actually true. */
        <Card className="overflow-hidden">
          <div className="border-b border-slate-200 bg-slate-900 p-5 sm:p-6">
            <Eyebrow tone="dark">Written curriculum · finished</Eyebrow>
            <h2 className="mt-2 text-xl font-semibold tracking-tight text-white sm:text-2xl">All {CURRICULUM.length} days complete</h2>
            <p className="mt-3 max-w-2xl text-sm leading-relaxed text-slate-300">
              You have finished every day written so far. That is {CURRICULUM.length} lessons and {CURRICULUM.reduce((n, d) => n + d.quiz.length, 0)} post-test
              questions — not a certificate, but real ground covered.
            </p>
          </div>
          <div className="p-5 sm:p-6">
            <div className="grid gap-4 sm:grid-cols-3">
              <div className="rounded-lg border border-slate-200 p-4">
                <p className="text-xs font-semibold uppercase tracking-widest text-slate-600">Longest streak</p>
                <p className="mt-1 text-2xl font-semibold tabular-nums text-slate-900">{streak.longest}</p>
              </div>
              <div className="rounded-lg border border-slate-200 p-4">
                <p className="text-xs font-semibold uppercase tracking-widest text-slate-600">Written curriculum</p>
                <p className="mt-1 text-2xl font-semibold tabular-nums text-slate-900">{progress.written}%</p>
              </div>
              <div className="rounded-lg border border-amber-200 bg-amber-50 p-4">
                <p className="text-xs font-semibold uppercase tracking-widest text-slate-600">Full roadmap</p>
                <p className="mt-1 text-2xl font-semibold tabular-nums text-slate-900">{progress.overall}%</p>
              </div>
            </div>
            <p className="mt-4 text-sm leading-relaxed text-slate-600">
              The two figures differ on purpose. {progress.written}% means you finished what has been written;
              {" "}{progress.overall}% is your position against the whole roadmap, and the gap is subject areas that have no
              lessons yet. Finishing here is not the same as knowing the field — the honest next move is the review list
              and the linked official documentation, not a new badge.
            </p>
            <div className="mt-6 flex flex-wrap gap-3">
              <Button size="lg" icon={RotateCcw} onClick={() => onGo("review")}>
                {review.length ? "Review " + review.length + " weak " + (review.length === 1 ? "concept" : "concepts") : "Check the review list"}
              </Button>
              <Button size="lg" variant="outline" icon={Library} onClick={() => onGo("resources")}>Go back to the sources</Button>
              <Button size="lg" variant="ghost" icon={BookOpen} onClick={() => onOpenLesson(day.day)}>Reread Day {day.day}</Button>
            </div>
          </div>
        </Card>
      ) : (
      <Card className="overflow-hidden">
        <div className="border-b border-slate-200 bg-slate-900 p-5 sm:p-6">
          <div className="flex flex-wrap items-center justify-between gap-3">
            <Eyebrow tone="dark">Today's learning · {prettyDate(dstr())}</Eyebrow>
            <Pill tone={STATUS_META[status].tone}>{STATUS_META[status].label}</Pill>
          </div>
          <h2 className="mt-2 text-xl font-semibold tracking-tight text-white sm:text-2xl">Day {day.day} — {day.title}</h2>
          <div className="mt-3 flex flex-wrap items-center gap-4 text-sm text-slate-300">
            <span className="inline-flex items-center gap-1.5"><Clock className="h-4 w-4" />{totalMinutes(day)} minutes</span>
            <span className="inline-flex items-center gap-1.5"><BookOpen className="h-4 w-4" />{sub.label}</span>
            <span className="inline-flex items-center gap-1.5 tabular-nums"><BarChart3 className="h-4 w-4" />{progress.subs[sub.id].pct}% → {projected}%</span>
          </div>
        </div>

        <div className="p-5 sm:p-6">
          <HourRibbon day={day} checked={checked} />
          <div className="mt-6 grid gap-6 sm:grid-cols-2">
            <div>
              <Eyebrow>What you will be able to do</Eyebrow>
              <ul className="mt-2 space-y-2">
                {day.objectives.map((o, i) => (
                  <li key={i} className="flex gap-2 text-sm text-slate-700"><Target className="mt-0.5 h-4 w-4 shrink-0 text-blue-700" />{o}</li>
                ))}
              </ul>
            </div>
            <div>
              <Eyebrow>Today's two steps</Eyebrow>
              <div className="mt-2 space-y-2">
                <div className={"flex items-center gap-3 rounded-lg border p-3 " + (lessonDone(state, day.day) ? "border-emerald-200 bg-emerald-50" : "border-slate-200")}>
                  {lessonDone(state, day.day) ? <CheckCircle2 className="h-5 w-5 text-emerald-700" /> : <Circle className="h-5 w-5 text-slate-300" />}
                  <span className="text-sm text-slate-700">Complete the 60-minute lesson</span>
                </div>
                {/* M14: the tick follows the pass, not the submission. Ticking this green on
                    a 40% would tell the learner the step was done while the day stayed
                    incomplete and the next day stayed locked. */}
                <div className={"flex items-center gap-3 rounded-lg border p-3 " + (testPassed(state, day.day) ? "border-emerald-200 bg-emerald-50" : testDone(state, day.day) ? "border-orange-200 bg-orange-50" : "border-slate-200")}>
                  {testPassed(state, day.day) ? <CheckCircle2 className="h-5 w-5 text-emerald-700" /> : testDone(state, day.day) ? <AlertTriangle className="h-5 w-5 text-orange-700" /> : lessonDone(state, day.day) ? <Circle className="h-5 w-5 text-slate-300" /> : <Lock className="h-5 w-5 text-slate-300" />}
                  <span className="text-sm text-slate-700">
                    Pass the post-test · {CONFIG.passThreshold}%
                    {bestPct(state, day.day) !== null ? " · best " + bestPct(state, day.day) + "%" : ""}
                    {testDone(state, day.day) && !testPassed(state, day.day) ? " · belum lulus" : ""}
                  </span>
                </div>
              </div>
            </div>
          </div>

          <div className="mt-6 flex flex-wrap gap-3">
            <Button size="lg" icon={BookOpen} onClick={() => onOpenLesson(day.day)}>
              {status === "not-started" ? "Start learning" : lessonDone(state, day.day) ? "Review the lesson" : "Continue learning"}
            </Button>
            {lessonDone(state, day.day) && (
              <Button size="lg" variant="outline" icon={GraduationCap} onClick={() => onOpenTest(day.day)}>
                {testDone(state, day.day) ? "Retake post-test" : "Take post-test"}
              </Button>
            )}
          </div>
        </div>
      </Card>
      )}

      <div className="grid gap-4 lg:grid-cols-3">
        <Card className="p-5 lg:col-span-2">
          <div className="flex items-center justify-between">
            <p className="font-semibold text-slate-900">Knowledge by domain</p>
            <button onClick={() => onGo("progress")} className="text-sm font-medium text-blue-700 hover:underline">See breakdown</button>
          </div>
          <div className="mt-4 space-y-4">
            {progress.domains.map((d) => (
              <div key={d.id}>
                <div className="flex items-baseline justify-between">
                  <p className="text-sm font-medium text-slate-700">{d.label}</p>
                  <p className="text-sm font-semibold tabular-nums text-slate-900">{d.pct}%</p>
                </div>
                <div className="mt-1.5"><Bar pct={d.pct} tone={d.id === "ai" ? "blue" : d.id === "digital" ? "emerald" : "slate"} /></div>
                <p className="mt-1 text-xs text-slate-500">{d.subs.filter((x) => x.pct > 0).length} of {d.subs.length} subtopics started</p>
              </div>
            ))}
          </div>
        </Card>

        <Card className="p-5">
          <div className="flex items-center justify-between">
            <p className="font-semibold text-slate-900">Needs review</p>
            {review.length > 0 && <Pill tone="rose">{review.length}</Pill>}
          </div>
          {review.length === 0 ? (
            <p className="mt-3 text-sm text-slate-500">Nothing flagged. A concept appears here when your most recent answers on it fall under {CONFIG.reviewThreshold}%.</p>
          ) : (
            <>
              <ul className="mt-3 space-y-2">
                {review.slice(0, 4).map((r) => (
                  <li key={r.concept} className="flex items-center justify-between gap-2 rounded-lg bg-rose-50 px-3 py-2">
                    <span className="truncate text-sm font-medium text-rose-900">{r.concept}</span>
                    <span className="shrink-0 text-xs tabular-nums text-rose-700">{r.accuracy}%</span>
                  </li>
                ))}
              </ul>
              <Button className="mt-4 w-full" variant="outline" size="sm" icon={RefreshCw} onClick={() => onGo("review")}>Open review</Button>
            </>
          )}
        </Card>
      </div>
    </div>
  );
}

/* --- Learning path -------------------------------------------------------- */

function PathView({ state, onOpenLesson }) {
  return (
    <div className="space-y-8">
      <div>
        <h1 className="text-2xl font-semibold tracking-tight text-slate-900">Learning path</h1>
        <p className="mt-1 text-sm text-slate-600">One hour per day, in prerequisite order. A day unlocks when the day before it is complete — lesson and post-test both.</p>
      </div>
      {PHASES.map((p) => {
        const days = CURRICULUM.filter((d) => d.day >= p.days[0] && d.day <= p.days[1]);
        const doneCount = days.filter((d) => dayCompleted(state, d.day)).length;
        return (
          <section key={p.id}>
            <div className="flex flex-wrap items-baseline justify-between gap-2">
              <h2 className="font-semibold tracking-tight text-slate-900">{p.label}</h2>
              <p className="text-sm tabular-nums text-slate-500">{doneCount}/{days.length} days</p>
            </div>
            <div className="mt-3 space-y-2">
              {days.map((d) => {
                const st = dayStatus(state, d.day);
                const meta = STATUS_META[st];
                const Icon = meta.icon;
                const locked = st === "locked";
                const score = bestPct(state, d.day);
                return (
                  <button key={d.day} disabled={locked} onClick={() => onOpenLesson(d.day)}
                    className={"flex w-full items-center gap-4 rounded-xl border p-4 text-left transition-colors " +
                      (locked ? "cursor-not-allowed border-slate-200 bg-slate-50" : "border-slate-200 bg-white hover:border-blue-300 hover:bg-blue-50")}>
                    <Icon className={"h-5 w-5 shrink-0 " + (st === "completed" ? "text-emerald-700" : st === "in-progress" ? "text-blue-700" : "text-slate-300")} />
                    <div className="min-w-0 flex-1">
                      <p className={"text-sm font-medium " + (locked ? "text-slate-500" : "text-slate-900")}>Day {d.day} — {d.title}</p>
                      <p className="mt-0.5 truncate text-xs text-slate-500">{SUB_INDEX[d.sub].label} · {totalMinutes(d)} min · {d.quiz.length} questions</p>
                    </div>
                    {score !== null && <span className="shrink-0 text-xs font-semibold tabular-nums text-slate-600">{score}%</span>}
                    {!locked && <ChevronRight className="h-4 w-4 shrink-0 text-slate-500" />}
                  </button>
                );
              })}
            </div>
          </section>
        );
      })}
    </div>
  );
}

/* --- Progress ------------------------------------------------------------- */

function ProgressView({ state, derived }) {
  const { progress } = derived;
  return (
    <div className="space-y-8">
      <div>
        <h1 className="text-2xl font-semibold tracking-tight text-slate-900">Progress</h1>
        <p className="mt-1 text-sm text-slate-600">
          Every number here is calculated, never typed. A day contributes {Math.round(CONFIG.lessonWeight * 100)}% of its credit for the lesson and up to {Math.round(CONFIG.testWeight * 100)}% scaled by your best post-test score. A subcategory is measured twice: against the days planned for it in the roadmap, and against the days actually written so far. Both are shown, because they answer different questions.
        </p>
      </div>

      <Card className="p-6">
        <div className="flex flex-wrap items-end justify-between gap-4">
          <div>
            <Eyebrow>Curriculum written so far</Eyebrow>
            <p className="mt-1 text-5xl font-semibold tabular-nums tracking-tight text-slate-900">{progress.written}%</p>
            <p className="mt-1 text-sm text-slate-500">Credit earned across the {progress.daysWritten} days that exist today</p>
            <p className="mt-3 text-sm text-slate-700"><span className="font-semibold tabular-nums">{progress.overall}%</span> of the full roadmap</p>
            <p className="mt-1 text-xs text-slate-500">
              The roadmap figure and every domain percentage are measured against all {progress.subsTotal} planned subcategories, of which {progress.subsWritten} have lessons written. They cannot reach 100% until the remaining days are written — that is a gap in the curriculum, not in your learning.
            </p>
          </div>
          <div className="grid grid-cols-3 gap-6">
            {progress.domains.map((d) => (
              <div key={d.id} className="text-right">
                <p className="text-2xl font-semibold tabular-nums text-slate-900">{d.pct}%</p>
                <p className="text-xs text-slate-500">{d.label}</p>
              </div>
            ))}
          </div>
        </div>
      </Card>

      {progress.domains.map((d) => (
        <section key={d.id}>
          <div className="flex items-baseline justify-between">
            <h2 className="font-semibold tracking-tight text-slate-900">{d.label}</h2>
            <p className="text-sm font-semibold tabular-nums text-slate-900">{d.pct}%</p>
          </div>
          <Card className="mt-3 divide-y divide-slate-100">
            {d.subs.map((s) => (
              <div key={s.id} className="p-4">
                <div className="flex flex-wrap items-baseline justify-between gap-2">
                  <p className="text-sm font-medium text-slate-800">{s.label}</p>
                  <p className="text-sm font-semibold tabular-nums text-slate-900">{s.pct}%</p>
                </div>
                <div className="mt-2"><Bar pct={s.pct} tone={s.pct === 0 ? "slate" : s.mastery === "Needs review" ? "orange" : "blue"} /></div>
                <div className="mt-2 flex flex-wrap items-center gap-x-4 gap-y-1 text-xs text-slate-500">
                  <span>{s.daysDone}/{s.daysPlanned || 0} lessons done{s.daysPlanned === 0 ? " · no lessons written yet" : ""}</span>
                  {s.pctWritten !== null && s.pctWritten !== s.pct && <span>{s.pctWritten}% of written days</span>}
                  {s.avgScore !== null && <span>Avg test {s.avgScore}%</span>}
                  <span className={s.mastery === "Needs review" ? "font-medium text-orange-700" : s.mastery === "Lesson done, not tested" ? "font-medium text-blue-700" : ""}>{s.mastery}</span>
                </div>
              </div>
            ))}
          </Card>
        </section>
      ))}
    </div>
  );
}

/* --- Resources ------------------------------------------------------------ */

function ResourcesView({ state }) {
  const [q, setQ] = useState("");
  const [onlyUnlocked, setOnlyUnlocked] = useState(true);
  const rows = CURRICULUM.flatMap((d) =>
    d.resources.map((r) => ({ r, d, locked: dayStatus(state, d.day) === "locked" }))
  ).filter((x) => (onlyUnlocked ? !x.locked : true))
   .filter((x) => {
      const t = (x.r.title + x.r.source + x.r.topic + x.d.title).toLowerCase();
      return t.includes(q.toLowerCase());
   });

  return (
    <div className="space-y-6">
      <div>
        <h1 className="text-2xl font-semibold tracking-tight text-slate-900">Resources</h1>
        <p className="mt-1 text-sm text-slate-600">
          Official documentation and recognised educational sources, free wherever possible. Each carries an Indonesian study summary written as original notes — not a translation — and a link to the original. Anything not confirmed against its source is labelled <span className="font-medium text-orange-700">Needs verification</span>: open it before relying on it.
        </p>
      </div>

      <div className="flex flex-col gap-3 sm:flex-row sm:items-center">
        <input value={q} onChange={(e) => setQ(e.target.value)} placeholder="Search by title, source or topic..."
          type="search" aria-label="Search resources by title, source or topic"
          className="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:border-blue-600 focus:outline-none focus:ring-1 focus:ring-blue-600" />
        <label className="flex shrink-0 items-center gap-2 text-sm text-slate-600">
          <input type="checkbox" checked={onlyUnlocked} onChange={(e) => setOnlyUnlocked(e.target.checked)} className="h-4 w-4 accent-blue-700" />
          Unlocked days only
        </label>
      </div>

      {rows.length === 0 ? (
        <Card className="p-8 text-center">
          <p className="font-medium text-slate-900">No resources match that search.</p>
          <p className="mt-1 text-sm text-slate-500">Clear the search box, or untick "unlocked days only" to see material from later days.</p>
        </Card>
      ) : (
        <div className="space-y-6">
          {[...new Set(rows.map((x) => x.d.day))].map((dayNum) => {
            const d = dayByNumber(dayNum);
            return (
              <div key={dayNum}>
                <p className="mb-2 text-sm font-medium text-slate-500">Day {d.day} · {d.title}</p>
                <div className="space-y-3">
                  {rows.filter((x) => x.d.day === dayNum).map((x, i) => <ResourceCard key={i} r={x.r} />)}
                </div>
              </div>
            );
          })}
        </div>
      )}
    </div>
  );
}

/* --- Review --------------------------------------------------------------- */

function ReviewView({ state, derived, onOpenLesson, onOpenTest }) {
  const { review, progress } = derived;
  const weakSubs = Object.values(progress.subs).filter((s) => s.mastery === "Needs review");

  return (
    <div className="space-y-6">
      <div>
        <h1 className="text-2xl font-semibold tracking-tight text-slate-900">Review</h1>
        <p className="mt-1 text-sm text-slate-600">
          Flags are read from your <span className="font-medium">most recent</span> attempt at each post-test, not from your whole history. A concept appears here when your latest answers on it fall under {CONFIG.reviewThreshold}%, and disappears as soon as a retake gets them right. Progress credit still keeps your best score, so retaking can only help you.
        </p>
      </div>

      {review.length === 0 && weakSubs.length === 0 ? (
        <Card className="p-8 text-center">
          <Sparkles className="mx-auto h-6 w-6 text-slate-300" />
          <p className="mt-2 font-medium text-slate-900">Nothing needs review yet.</p>
          <p className="mt-1 text-sm text-slate-500">Take a few post-tests and weak concepts will surface here automatically.</p>
        </Card>
      ) : (
        <>
          {review.length > 0 && (
            <section>
              <h2 className="font-semibold tracking-tight text-slate-900">Weak concepts</h2>
              <div className="mt-3 space-y-3">
                {review.map((r) => (
                  <Card key={r.concept} className="border-l-4 border-l-rose-500 p-5">
                    <div className="flex flex-wrap items-start justify-between gap-3">
                      <div>
                        <div className="flex items-center gap-2">
                          <AlertTriangle className="h-4 w-4 text-rose-700" />
                          <p className="font-semibold text-slate-900">{r.concept}</p>
                        </div>
                        <p className="mt-1 text-sm text-slate-600">{r.accuracy}% on your latest attempt — {r.correct} of {r.attempted} question{r.attempted > 1 ? "s" : ""} right{r.lastSeen ? ", answered " + prettyDate(r.lastSeen) : ""}.</p>
                        <p className="mt-2 text-sm text-slate-600">
                          Reread the relevant segment, then retake the post-test: {r.days.map((d) => "Day " + d).join(", ")}.
                        </p>
                      </div>
                      <div className="flex flex-wrap gap-2">
                        {r.days.map((d) => (
                          <Button key={d} size="sm" variant="outline" onClick={() => onOpenLesson(d)}>Review Day {d}</Button>
                        ))}
                        {r.days.filter((d) => lessonDone(state, d)).map((d) => (
                          <Button key={"t" + d} size="sm" icon={RotateCcw} onClick={() => onOpenTest(d)}>Retake Day {d}</Button>
                        ))}
                      </div>
                    </div>
                  </Card>
                ))}
              </div>
            </section>
          )}

          {weakSubs.length > 0 && (
            <section>
              <h2 className="font-semibold tracking-tight text-slate-900">Knowledge areas below the pass mark</h2>
              <Card className="mt-3 divide-y divide-slate-100">
                {weakSubs.map((s) => (
                  <div key={s.id} className="flex flex-wrap items-center justify-between gap-3 p-4">
                    <div>
                      <p className="text-sm font-medium text-slate-900">{s.label}</p>
                      <p className="text-xs text-slate-500">Average post-test score {s.avgScore}% · {s.pct}% progress</p>
                    </div>
                    <Pill tone="orange">{s.mastery}</Pill>
                  </div>
                ))}
              </Card>
            </section>
          )}
        </>
      )}
    </div>
  );
}

/* --- History -------------------------------------------------------------- */

function HistoryView({ state, derived }) {
  const { streak } = derived;
  const done = new Set(completionDates(state));
  const mins = minutesByDate(state);
  const today = dstr();
  const weeks = 12;
  const cells = [];
  const start = shiftDate(today, -(weeks * 7 - 1));
  for (let i = 0; i < weeks * 7; i++) {
    const date = shiftDate(start, i);
    let kind = "future";
    if (date === today) kind = done.has(date) ? "completed" : mins[date] ? "partial" : "today";
    else if (date < today) {
      if (done.has(date)) kind = "completed";
      else if (mins[date]) kind = "partial";
      else if (date >= state.startDate) kind = "missed";
      else kind = "before";
    }
    cells.push({ date, kind, mins: mins[date] || 0 });
  }
  const cls = {
    completed: "bg-emerald-600",
    partial: "bg-blue-400",
    missed: "bg-slate-200",
    today: "bg-white ring-2 ring-blue-600",
    before: "bg-slate-100",
    future: "bg-slate-100",
  };
  const history = CURRICULUM.filter((d) => dayCompleted(state, d.day))
    .map((d) => ({ d, date: completionDate(state, d.day), score: bestPct(state, d.day), attempts: state.tests[d.day].attempts.length }))
    .sort((a, b) => (a.date < b.date ? 1 : -1));

  return (
    <div className="space-y-6">
      <div>
        <h1 className="text-2xl font-semibold tracking-tight text-slate-900">History</h1>
        <p className="mt-1 text-sm text-slate-600">A day counts as complete only when the lesson is finished and the post-test scored at least {CONFIG.passThreshold}%. A submitted test below that does not count, and does not extend your streak. Opening the dashboard does nothing to your streak.</p>
      </div>

      <div className="grid grid-cols-3 gap-3">
        <StatTile icon={Flame} tone="orange" label="Current streak" value={streak.current} sub="consecutive days" />
        <StatTile icon={Award} tone="emerald" label="Longest streak" value={streak.longest} sub="personal best" />
        <StatTile icon={CalendarDays} label="Total days" value={streak.total} sub="lessons + tests done" />
      </div>

      {streak.future > 0 && (
        <div role="status" className="rounded-xl border border-amber-200 bg-amber-50 p-4">
          <div className="flex items-start gap-3">
            <AlertTriangle className="mt-0.5 h-5 w-5 shrink-0 text-amber-700" />
            <p className="text-sm text-slate-700">
              <span className="font-semibold text-amber-900">{streak.future} completed {streak.future === 1 ? "day is" : "days are"} dated in the future.</span>{" "}
              {streak.future === 1 ? "It still counts" : "They still count"} towards your total, but {streak.future === 1 ? "it is" : "they are"} excluded from the streak, because a future date would otherwise hold a streak open indefinitely. This usually means the device clock was wrong when the day was completed.
            </p>
          </div>
        </div>
      )}

      <Card className="p-5">
        <p className="font-semibold text-slate-900">Last 12 weeks</p>
        <div className="mt-4 overflow-x-auto pb-2">
          <div className="flex gap-1">
            {Array.from({ length: weeks }).map((_, w) => (
              <div key={w} className="flex flex-col gap-1">
                {cells.slice(w * 7, w * 7 + 7).map((c) => (
                  <div key={c.date} title={prettyDate(c.date) + (c.kind === "completed" ? " · completed" : c.mins ? " · " + c.mins + " min studied" : "")}
                    className={"h-4 w-4 rounded-sm " + cls[c.kind]} />
                ))}
              </div>
            ))}
          </div>
        </div>
        <div className="mt-3 flex flex-wrap gap-4 text-xs text-slate-500">
          <span className="inline-flex items-center gap-1.5"><span className="h-3 w-3 rounded-sm bg-emerald-600" />Completed</span>
          <span className="inline-flex items-center gap-1.5"><span className="h-3 w-3 rounded-sm bg-blue-400" />Partial</span>
          <span className="inline-flex items-center gap-1.5"><span className="h-3 w-3 rounded-sm bg-slate-200" />Missed</span>
          <span className="inline-flex items-center gap-1.5"><span className="h-3 w-3 rounded-sm bg-white ring-2 ring-blue-600" />Today</span>
        </div>
      </Card>

      <section>
        <h2 className="font-semibold tracking-tight text-slate-900">Completed days</h2>
        {history.length === 0 ? (
          <Card className="mt-3 p-8 text-center">
            <p className="font-medium text-slate-900">No completed days yet.</p>
            <p className="mt-1 text-sm text-slate-500">Finish Day 1 and submit its post-test to start the record.</p>
          </Card>
        ) : (
          <Card className="mt-3 divide-y divide-slate-100">
            {history.map((h) => (
              <div key={h.d.day} className="flex flex-wrap items-center justify-between gap-3 p-4">
                <div className="min-w-0">
                  <p className="truncate text-sm font-medium text-slate-900">Day {h.d.day} — {h.d.title}</p>
                  <p className="text-xs text-slate-500">{prettyDate(h.date)} · {SUB_INDEX[h.d.sub].label} · {h.attempts} attempt{h.attempts > 1 ? "s" : ""}</p>
                </div>
                <Pill tone={h.score >= CONFIG.passThreshold ? "emerald" : "orange"}>{h.score}%</Pill>
              </div>
            ))}
          </Card>
        )}
      </section>
    </div>
  );
}

/* --- Demo history (clearly labelled, easy to clear) ----------------------- */

/* One entry per day, each entry a list of attempts, each attempt the indices answered
   wrongly. Day 3 deliberately carries a failed first attempt (3 of 6 wrong = 50%) followed
   by a passing retake, because since M14 a failed post-test leaves the day incomplete and
   the next day locked. A single 50% attempt would have produced a demo in which Day 4 has a
   finished lesson and a submitted test but is still locked — a state the app can no longer
   reach by playing normally. The retake also shows the fail-then-pass path the completion
   date now has to handle. */
const DEMO_ATTEMPTS = { 1: [[]], 2: [[4]], 3: [[1, 4, 5], [4]], 4: [[5]] };
function buildDemoState() {
  const s = { ...EMPTY_STATE, startDate: shiftDate(dstr(), -4), lessons: {}, tests: {} };
  [1, 2, 3, 4].forEach((n, i) => {
    const day = dayByNumber(n);
    const date = shiftDate(dstr(), -4 + i);
    const segs = {};
    day.segments.forEach((_, idx) => (segs[idx] = date));
    s.lessons[n] = { completedAt: date, segments: segs };
    s.tests[n] = {
      attempts: DEMO_ATTEMPTS[n].map((wrong) => {
        const detail = day.quiz.map((q, qi) => ({ index: qi, concept: q.c, correct: !wrong.includes(qi), given: null }));
        const correct = detail.filter((d) => d.correct).length;
        const pct = Math.round((correct / day.quiz.length) * 100);
        return { date, correct, total: day.quiz.length, pct, passed: pct >= CONFIG.passThreshold, detail };
      }),
    };
  });
  return s;
}

/* --- App shell ------------------------------------------------------------ */

const NAV = [
  { id: "dashboard", label: "Dashboard", icon: LayoutDashboard },
  { id: "path", label: "Learning path", icon: Library },
  { id: "progress", label: "Progress", icon: BarChart3 },
  { id: "resources", label: "Resources", icon: BookOpen },
  { id: "review", label: "Review", icon: ShieldQuestion },
  { id: "history", label: "History", icon: History },
];

export default function LearningDashboard() {
  const [state, setState] = useState(EMPTY_STATE);
  const [loaded, setLoaded] = useState(false);
  const [persist, setPersist] = useState("checking"); // checking | on | off | blocked
  const [loadIssue, setLoadIssue] = useState(null);   // { kind, backup, version?, dropped? }
  const [view, setView] = useState("dashboard");
  const [mode, setMode] = useState(null);      // { type: "lesson" | "test", day }
  const [menuOpen, setMenuOpen] = useState(false);
  const [confirmReset, setConfirmReset] = useState(false);

  // Load saved state once. If storage is unavailable, say so rather than pretend.
  useEffect(() => {
    let cancelled = false;
    (async () => {
      if (typeof window === "undefined" || !window.storage) {
        if (!cancelled) { setPersist("off"); setLoaded(true); }
        return;
      }
      // A record we cannot read is never overwritten. It is copied to a backup key and
      // saving is blocked, so a parse error or an unknown version cannot erase progress.
      let raw = null;
      try {
        const res = await window.storage.get(STORAGE_KEY);
        raw = res && res.value ? res.value : null;
      } catch (e) {
        if (!cancelled) { setPersist("on"); setLoaded(true); } // no saved key yet is not an error
        return;
      }
      if (raw === null) {
        if (!cancelled) { setPersist("on"); setLoaded(true); }
        return;
      }

      let parsed = null, failure = null;
      try {
        parsed = JSON.parse(raw);
        if (!parsed || typeof parsed !== "object") failure = "unreadable";
        else if (parsed.version > STATE_VERSION) failure = "newer";
        else if (parsed.version !== STATE_VERSION) failure = "unknown";
      } catch (e) {
        failure = "unreadable";
      }

      if (failure) {
        let backup = null;
        try {
          backup = BACKUP_KEY_PREFIX + dstr();
          await window.storage.set(backup, raw);
        } catch (e) { backup = null; }
        if (!cancelled) {
          setPersist("blocked");
          setLoadIssue({ kind: failure, backup, version: parsed?.version ?? null });
          setLoaded(true);
        }
        return;
      }

      const { state: clean, dropped } = normalizeState(parsed);
      if (!cancelled) {
        setState(clean);
        if (dropped.length) {
          let backup = null;
          try {
            backup = BACKUP_KEY_PREFIX + dstr();
            await window.storage.set(backup, raw);
          } catch (e) { backup = null; }
          if (!cancelled) setLoadIssue({ kind: "repaired", backup, dropped });
        }
        setPersist("on");
        setLoaded(true);
      }
    })();
    return () => { cancelled = true; };
  }, []);

  // Save on every change once loading has finished.
  useEffect(() => {
    if (!loaded || persist !== "on") return;
    let cancelled = false;
    (async () => {
      try {
        await window.storage.set(STORAGE_KEY, JSON.stringify(state));
      } catch (e) {
        if (!cancelled) setPersist("off");
      }
    })();
    return () => { cancelled = true; };
  }, [state, loaded, persist]);

  const derived = useMemo(() => ({
    streak: streakStats(state),
    progress: knowledgeProgress(state),
    review: reviewItems(state),
    active: dayByNumber(activeDayNumber(state)),
  }), [state]);

  const toggleSegment = useCallback((dayNum, idx) => {
    setState((s) => {
      const lesson = s.lessons[dayNum] || { completedAt: null, segments: {} };
      const segments = { ...lesson.segments };
      if (segments[idx] !== undefined) delete segments[idx];
      else segments[idx] = dstr();
      return { ...s, lessons: { ...s.lessons, [dayNum]: { ...lesson, segments } } };
    });
  }, []);

  const completeLesson = useCallback((dayNum) => {
    setState((s) => {
      const day = dayByNumber(dayNum);
      const lesson = s.lessons[dayNum] || { completedAt: null, segments: {} };
      const segments = { ...lesson.segments };
      day.segments.forEach((_, i) => { if (segments[i] === undefined) segments[i] = dstr(); });
      return { ...s, lessons: { ...s.lessons, [dayNum]: { completedAt: dstr(), segments } } };
    });
  }, []);

  const submitTest = useCallback((dayNum, result) => {
    setState((s) => {
      const prev = s.tests[dayNum]?.attempts || [];
      return { ...s, tests: { ...s.tests, [dayNum]: { attempts: [...prev, result] } } };
    });
  }, []);

  const openLesson = (dayNum) => { setMode({ type: "lesson", day: dayNum }); setMenuOpen(false); window.scrollTo({ top: 0 }); };
  const openTest = (dayNum) => { setMode({ type: "test", day: dayNum }); setMenuOpen(false); window.scrollTo({ top: 0 }); };
  const goto = (v) => { setView(v); setMode(null); setMenuOpen(false); window.scrollTo({ top: 0 }); };

  // Escape closes the mobile drawer. Without this the only way out was tapping the backdrop,
  // which is unreachable by keyboard. A full focus trap is NOT implemented — see the
  // accessibility notes in CLAUDE-WORK-STATE.md.
  useEffect(() => {
    if (!menuOpen) return;
    const onKey = (e) => { if (e.key === "Escape") setMenuOpen(false); };
    window.addEventListener("keydown", onKey);
    return () => window.removeEventListener("keydown", onKey);
  }, [menuOpen]);

  const persistNote =
    persist === "on" ? "Saved on this device"
    : persist === "off" ? "Not saved — this session only"
    : persist === "blocked" ? "Saving paused — existing record protected"
    : "Checking storage...";

  // Explicit, user-initiated escape from the blocked state. Nothing overwrites silently.
  const startFresh = () => {
    setState({ ...EMPTY_STATE, startDate: dstr() });
    setLoadIssue(null);
    setPersist("on");
    goto("dashboard");
  };

  const issueBanner = loadIssue && (
    <div role="alert" className={"mb-6 rounded-xl border p-4 " + (loadIssue.kind === "repaired" ? "border-amber-200 bg-amber-50" : "border-rose-200 bg-rose-50")}>
      <div className="flex items-start gap-3">
        <AlertTriangle className={"mt-0.5 h-5 w-5 shrink-0 " + (loadIssue.kind === "repaired" ? "text-amber-700" : "text-rose-700")} />
        <div className="min-w-0">
          <p className={"text-sm font-semibold " + (loadIssue.kind === "repaired" ? "text-amber-900" : "text-rose-900")}>
            {loadIssue.kind === "repaired" ? "Saved progress was loaded with repairs"
              : loadIssue.kind === "newer" ? "Saved progress was written by a newer version"
              : "Saved progress could not be read"}
          </p>
          <p className="mt-1 text-sm text-slate-700">
            {loadIssue.kind === "repaired"
              ? "Some entries did not match the expected shape and were left out: " + loadIssue.dropped.slice(0, 6).join(", ") +
                (loadIssue.dropped.length > 6 ? ", and " + (loadIssue.dropped.length - 6) + " more." : ".")
              : "Nothing has been overwritten. Saving is paused so the existing record stays intact — anything you do in this session will be lost on reload until you choose an option below."}
          </p>
          <p className="mt-1 text-xs text-slate-500">
            {loadIssue.backup
              ? "A verbatim copy was stored under the key " + loadIssue.backup + "."
              : "The backup copy could not be written, so the original record is the only copy — do not reset."}
            {loadIssue.version !== null && loadIssue.version !== undefined ? " Record version: " + loadIssue.version + "; this build reads version " + STATE_VERSION + "." : ""}
          </p>
          {loadIssue.kind === "repaired" ? (
            <Button className="mt-3" size="sm" variant="outline" onClick={() => setLoadIssue(null)}>Understood</Button>
          ) : (
            <Button className="mt-3" size="sm" variant="danger" onClick={startFresh}>Start fresh and overwrite the saved record</Button>
          )}
        </div>
      </div>
    </div>
  );

  const Sidebar = (
    <nav className="flex h-full flex-col">
      <div className="px-4 py-5">
        <p className="text-sm font-semibold tracking-tight text-slate-900">AI &amp; Digital Learning</p>
        <p className="mt-0.5 text-xs text-slate-500">One hour a day, in order</p>
      </div>
      <div className="flex-1 space-y-1 px-2">
        {NAV.map((n) => {
          const Icon = n.icon;
          const activeItem = view === n.id && !mode;
          return (
            <button key={n.id} onClick={() => goto(n.id)}
              className={"flex w-full items-center gap-3 rounded-lg px-3 py-2 text-sm font-medium transition-colors " +
                (activeItem ? "bg-slate-900 text-white" : "text-slate-600 hover:bg-slate-100 hover:text-slate-900")}>
              <Icon className="h-4 w-4" />
              {n.label}
              {n.id === "review" && derived.review.length > 0 && (
                <span className="ml-auto rounded-full bg-rose-100 px-2 py-0.5 text-xs font-semibold text-rose-700">{derived.review.length}</span>
              )}
            </button>
          );
        })}
      </div>
      <div className="space-y-2 border-t border-slate-200 p-4">
        <p className="text-xs text-slate-500">{persistNote}</p>
        {streakStats(state).total === 0 && (
          <Button size="sm" variant="outline" className="w-full" onClick={() => { setState(buildDemoState()); setMenuOpen(false); }}>Load demo history</Button>
        )}
        <Button size="sm" variant={confirmReset ? "danger" : "ghost"} className="w-full"
          onClick={() => { if (confirmReset) { setState({ ...EMPTY_STATE, startDate: dstr() }); setConfirmReset(false); goto("dashboard"); } else setConfirmReset(true); }}>
          {confirmReset ? "Confirm — erase all progress" : "Reset progress"}
        </Button>
      </div>
    </nav>
  );

  let main;
  if (!loaded) {
    main = <div className="py-24 text-center text-sm text-slate-500">Loading your progress...</div>;
  } else if (mode?.type === "lesson") {
    main = <LessonView day={dayByNumber(mode.day)} state={state}
      onToggleSegment={(i) => toggleSegment(mode.day, i)}
      onCompleteLesson={() => completeLesson(mode.day)}
      onStartTest={() => openTest(mode.day)}
      onBack={() => goto("dashboard")} />;
  } else if (mode?.type === "test") {
    main = <TestView day={dayByNumber(mode.day)} state={state}
      onSubmit={(r) => submitTest(mode.day, r)}
      onBack={() => goto("dashboard")} />;
  } else if (view === "path") {
    main = <PathView state={state} onOpenLesson={openLesson} />;
  } else if (view === "progress") {
    main = <ProgressView state={state} derived={derived} />;
  } else if (view === "resources") {
    main = <ResourcesView state={state} />;
  } else if (view === "review") {
    main = <ReviewView state={state} derived={derived} onOpenLesson={openLesson} onOpenTest={openTest} />;
  } else if (view === "history") {
    main = <HistoryView state={state} derived={derived} />;
  } else {
    main = <DashboardView state={state} derived={derived} onOpenLesson={openLesson} onOpenTest={openTest} onGo={goto} />;
  }

  return (
    <div className="min-h-screen bg-slate-50 text-slate-900">
      {/* Mobile bar */}
      <header className="sticky top-0 z-30 flex items-center justify-between border-b border-slate-200 bg-white px-4 py-3 lg:hidden">
        <div className="flex items-center gap-2">
          <button onClick={() => setMenuOpen((v) => !v)} className="rounded-lg p-2 text-slate-600 hover:bg-slate-100"
            aria-label="Toggle navigation" aria-expanded={menuOpen} aria-controls="mobile-nav">
            {menuOpen ? <X className="h-5 w-5" /> : <Menu className="h-5 w-5" />}
          </button>
          <p className="text-sm font-semibold tracking-tight">AI &amp; Digital Learning</p>
        </div>
        <span className="inline-flex items-center gap-1 rounded-full bg-orange-50 px-2.5 py-1 text-xs font-semibold text-orange-700">
          <Flame className="h-3.5 w-3.5" />{derived.streak.current}
        </span>
      </header>

      {menuOpen && (
        <div className="fixed inset-0 z-20 lg:hidden">
          {/* Dismissing by tapping the backdrop is a mouse/touch convenience. The keyboard
              path is Escape (handled above) and the toggle button, which stays focusable. */}
          <div className="absolute inset-0 bg-slate-900 opacity-30" onClick={() => setMenuOpen(false)} aria-hidden="true" />
          <div id="mobile-nav" role="dialog" aria-modal="true" aria-label="Navigation"
            className="absolute inset-y-0 left-0 w-64 border-r border-slate-200 bg-white pt-16">{Sidebar}</div>
        </div>
      )}

      <div className="mx-auto flex max-w-7xl">
        <aside className="sticky top-0 hidden h-screen w-60 shrink-0 border-r border-slate-200 bg-white lg:block">{Sidebar}</aside>
        <main className="min-w-0 flex-1 px-4 py-6 sm:px-6 lg:px-8 lg:py-8">
          {loaded && issueBanner}
          {main}
          <footer className="mt-12 border-t border-slate-200 pt-6 text-xs leading-relaxed text-slate-500">
            <p>Progress, streaks and review flags are calculated from your completions and post-test answers — none of them are hard-coded. A day is complete when the lesson is finished and your best post-test score reaches {CONFIG.passThreshold}%; failed attempts are kept in your history and still feed the review list, but they do not complete a day or unlock the next one. Short answers are graded by keyword matching in both English and Bahasa Indonesia, so treat borderline results as a prompt to re-read rather than a verdict.</p>
            <p className="mt-2">{persistNote}. Curriculum content is written for study, not as a certified reference; verify implementation details against the linked official documentation.</p>
          </footer>
        </main>
      </div>
    </div>
  );
}
