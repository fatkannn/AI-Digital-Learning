    quiz: [
      { t: "mc", c: "Relational modelling", q: "What is the role of a foreign key?", opts: ["To encrypt sensitive columns", "To reference the primary key of another table, creating a relationship", "To speed up queries automatically", "To store JSON documents"], a: 1, e: "Foreign keys express relationships and let the database enforce referential integrity." },
      { t: "tf", c: "Relational modelling", q: "Storing multiple course names in one text column is good relational design.", a: false, e: "It breaks queryability and integrity. One row per relationship is the normalised alternative." },
      { t: "mc", c: "Database types", q: "Which database type answers 'find items semantically similar to this text'?", opts: ["Relational database", "Vector database", "Key-value cache", "File system"], a: 1, e: "Vector databases index embeddings and search by distance in vector space. This is the retrieval layer in RAG." },
      { t: "sc", c: "Database types", q: "You need transactional accuracy for enrolments and payments. Which storage model fits best?", opts: ["Vector database", "Relational database with transactions", "Plain CSV files", "A spreadsheet shared on a drive"], a: 1, e: "Relational systems provide transactional guarantees; that is precisely what payment and enrolment records need." },
      { t: "mc", c: "SQL", q: "In SQL, which clause filters which rows are returned?", opts: ["SELECT", "FROM", "WHERE", "JOIN"], a: 2, e: "SELECT chooses columns, FROM chooses the source, JOIN combines tables, WHERE filters rows." },
      { t: "sa", c: "Relational modelling", q: "Why does data structure determine which questions are cheap to answer later?", a: { groups: [["query", "ditanya", "tanya", "kueri"], ["structure", "terstruktur", "struktur"], ["join", "hubung", "gabung", "relasi", "relation"], ["index", "indeks"], ["normal", "normalisasi"]], need: 2, model: "A normalised structure lets the engine filter, join and index directly; unstructured text forces parsing and makes some questions impractical." }, e: "Structure is what queries operate on." },
