        id: { apa: "Latihan praktik SQL dan basis data relasional dengan pendekatan langsung praktik.",
          inti: ["Menulis query dasar.", "Menghubungkan beberapa tabel.", "Normalisasi sederhana.", "Menghindari duplikasi data."],
          kenapa: "Kemampuan membaca dan menulis query membuat Anda mandiri saat menganalisis data pembelajaran.",
          hubungan: "Mendukung materi learning analytics di jalur Applied AI." } },
