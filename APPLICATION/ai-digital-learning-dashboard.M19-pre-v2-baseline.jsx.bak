    resources: [
      { title: "MCP Specification", source: "Model Context Protocol", topic: "MCP", difficulty: "Intermediate–Advanced", minutes: 40, url: "https://modelcontextprotocol.io/specification/2025-06-18", verified: true,
        id: { apa: "Spesifikasi resmi protokol: peran host, client, dan server; kemampuan yang bisa ditawarkan tiap sisi; serta bagian keamanan dan kepercayaan.",
          inti: ["Pesan memakai JSON-RPC; koneksi bersifat stateful dengan negosiasi kemampuan.", "Server menawarkan resources, prompts, dan tools.", "Client bisa menawarkan sampling, roots, dan elicitation ke server.", "Bagian keamanan menyatakan tool adalah eksekusi kode sembarang dan perlu kehati-hatian.", "Deskripsi tool harus dianggap tidak tepercaya kecuali berasal dari server tepercaya."],
          kenapa: "Bagian keamanannya pendek dan tegas, dan itu satu-satunya bacaan yang benar-benar wajib sebelum memasang server MCP pihak ketiga.",
